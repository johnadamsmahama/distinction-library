NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SERVER-ONLY — no NEXT_PUBLIC_ prefix. Bypasses Row Level Security entirely.
# Used only in app/api/moderation/approve-paper/[id]/route.ts to move a raw
# upload into the public bucket after watermarking. Never expose this to
# the browser bundle. Find it in Supabase: Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Used by the AI Quiz Generator and AI Study Companion (app/api/vault/*).
# Server-only — never exposed to the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key
RESEND_API_KEY=your-resend-api-key
